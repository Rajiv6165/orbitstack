SECRET_KEY=super-secret-jwt-key-CHANGE-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL & PgBouncer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
PGBOUNCER_PORT=6432

# Database URLs (direct to PostgreSQL or through PgBouncer pooler on 6432)
# DATABASE_URL=postgresql://postgres:postgres@localhost:6432/auth_db

# Service URLs (used when running services locally outside Docker)
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002
REDIS_URL=redis://localhost:6379
